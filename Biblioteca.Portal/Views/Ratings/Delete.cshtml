@model BibliotecaGrpc.RatingItem

<h2>Șterge evaluarea</h2>

<p>Sigur dorești să ștergi evaluarea pentru <strong>@Model.Title</strong>?</p>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">@ViewBag.Error</div>
}

<form asp-action="Delete" method="post">
    <input type="hidden" name="id" value="@Model.Id" />

    <button type="submit" class="btn btn-danger">Confirmă ștergerea</button>
    <a asp-action="Index">Anulează</a>
</form>