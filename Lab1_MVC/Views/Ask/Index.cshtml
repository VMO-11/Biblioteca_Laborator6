@model AskViewModel

@{
    ViewData["Title"] = "Intreaba biblioteca";
}

<h2>Intreaba biblioteca</h2>

<form asp-action="Index" method="post">
    @Html.AntiForgeryToken()
    
    <div class="mb-3">
        <label asp-for="Source" class="form-label"></label>
        <select asp-for="Source" class="form-select">
            <option value="regulament">Regulamentul bibliotecii</option>
            <option value="cont-online">Contul online al cititorului</option>
        </select>
    </div>


    <label asp-for="Question"></label>
    <textarea asp-for="Question" class="form-control" rows="3"></textarea>

    <button type="submit" class="btn btn-primary mt-2">
        Intreaba
    </button>
</form>

@if (!string.IsNullOrEmpty(Model.Answer))
{
    <hr />

    <h3>Raspuns</h3>
    <p style="white-space: pre-wrap">@Model.Answer</p>

    <p>Timp: @Model.Milliseconds ms</p>

    <h3>Surse utilizate</h3>

    <table class="table">
        <thead>
        <tr>
            <th>Nr.</th>
            <th>Sectiune</th>
            <th>Scor</th>
            <th>Fragment</th>
        </tr>
        </thead>
        <tbody>
        @for (int i = 0; i < Model.Sources.Count; i++)
        {
            var s = Model.Sources[i];

            <tr>
                <td>[@(i + 1)]</td>
                <td>@s.Title</td>
                <td>@s.Score.ToString("F3")</td>
                <td>@s.Text</td>
            </tr>
        }
        </tbody>
    </table>
}